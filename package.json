{
  "name": "dsh-dev-modes",
  "version": "1.0.0",
  "type": "module",
  "description": "Three DeepSeek Harness Agent presets in one bundle: software development, game development, and read-only discussion, with the matching delivery and engine workflows bundled as skills.",
  "author": "qingfengshangnanzhi",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
